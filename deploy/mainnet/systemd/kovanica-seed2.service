[Unit]
Description=Kovanica Mainnet Seed Node (seed2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/kovanica-mainnet
Environment=KOVANICA_CONSENSUS=poa
Environment=KOVANICA_AUTHORITIES=<VALIDATOR_PUBKEYS_COMMA_SEPARATED>
Environment=KOVANICA_AUTHORITY_THRESHOLD=5
Environment=KOVANICA_SLOT_DURATION=120000
Environment=KOVANICA_PEERS=seed1.mainnet.kovanica.online:9000,seed3.mainnet.kovanica.online:9000
Environment=KOVANICA_LISTEN=0.0.0.0:9000
Environment=KOVANICA_DATA=/var/lib/kovanica-mainnet
Environment=KOVANICA_OPERATOR=0
Environment=KOVANICA_FAUCET=0
Environment=KOVANICA_ALLOW_RESET=0
Environment=KOVANICA_METRICS=0.0.0.0:9090
# EnvironmentFile=/etc/kovanica/authority-keys/authority-2.env
ExecStart=/usr/local/bin/kovanica-node explorer 127.0.0.1:8080
Restart=always
RestartSec=30
LimitNOFILE=65536
MemoryMax=8G

[Install]
WantedBy=multi-user.target