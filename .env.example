# kovanica-web environment. Copy to .env (never commit .env).
# Use DNS names only — never IP addresses, keys or secrets in this file.

# --- Public network config (inlined into the client bundle at build time) ---
# Bootstrap seeds clones dial, comma separated host:port.
KOVANICA_PUBLIC_SEED_PEERS=seed1.kovanica.online:8000,seed2.kovanica.online:8000,seed3.kovanica.online:8000
# P2P TCP port shown in docs/operator instructions.
KOVANICA_PUBLIC_P2P_PORT=8000

# --- Server-only (never exposed to the browser) ---
# HTTP API of the co-located Rust node that /api is proxied to.
KOVANICA_NODE_API_URL=http://127.0.0.1:8080

# --- Auth (server-only; leave blank unless sign-in is enabled) ---
# "false" turns sign-in off everywhere (also inlined into the client at build).
VITE_AUTH_ENABLED=false
# Per-app OAuth client at the auth broker. Values come from the broker, never from git.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# Live-preview-only shared client secret (*.grok-sandbox.com). Not needed on the VPS.
GROK_PREVIEW_CLIENT_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=
