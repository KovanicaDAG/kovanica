# kovanica-web environment. Copy to .env (never commit .env).
# Use DNS names only — never IP addresses, keys or secrets in this file.

# --- Public network config (inlined into the client bundle at build time) ---
# Bootstrap seeds clones dial, comma separated host:port.
KOVANICA_PUBLIC_SEED_PEERS=seed.kovanica.online:9000,seed2.kovanica.online:9000
# P2P TCP port shown in docs/operator instructions.
KOVANICA_PUBLIC_P2P_PORT=9000
# Mining pool stratum endpoint (pool page).
KOVANICA_PUBLIC_POOL_STRATUM_URL=stratum+tcp://pool.kovanica.online:3333
