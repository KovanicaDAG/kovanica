# /etc/kovanica/seed1.env  (Chain 2 public testnet seed 1; host seed1.kovanica.online)
KOVANICA_CHAIN_ID=2
KOVANICA_DATA_DIR=/var/lib/kovanica-seed1
KOVANICA_LISTEN_ADDR=0.0.0.0:8000
# RPC bound to loopback; nginx (ops/ingress/nginx/seed1.conf) exposes it with rate limiting
KOVANICA_RPC_ADDR=127.0.0.1
KOVANICA_RPC_PORT=8545
KOVANICA_RPC_RATE_LIMIT_PER_MIN=120
KOVANICA_MAX_PEERS=50
# Fixed P2P identity: generate once with ./gen-p2p-key.sh, keep 0600
KOVANICA_P2P_KEY=/etc/kovanica/seed1.p2p.key
# Other seeds (fill after keys/IPs are known)
KOVANICA_BOOTNODES=seed1.kovanica.online:8000,seed2.kovanica.online:8000,seed3.kovanica.online:8000
KOVANICA_DNS_SEEDS=seed.kovanica.online:8000
KOVANICA_RUN_VALIDATOR=true
KOVANICA_MINING_ENABLED=true
KOVANICA_MINING_THREADS=1
KOVANICA_MINING_AUTHOR=0
# DNS seeder crawler (enable on one seed only)
KOVANICA_SEEDER_ENABLED=true
KOVANICA_SEEDER_DOMAIN=seed.kovanica.online
KOVANICA_SEEDER_ZONE_FILE=/var/lib/kovanica-seed1/seed.kovanica.online.zone
KOVANICA_SEEDER_INTERVAL_SECS=30
KOVANICA_SEEDER_TTL_SECS=60
RUST_LOG=info
