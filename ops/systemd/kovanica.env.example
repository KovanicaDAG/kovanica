# /etc/kovanica/kovanica.env
# Canonical environment configuration for Kovanica node & seed instances.

# Network Identification (1: Mainnet, 2: Hybrid PoW Testnet, 3: Devnet, 1337: Local)
KOVANICA_CHAIN_ID=2

# Data directory path
KOVANICA_DATA_DIR=/var/lib/kovanica

# P2P Listen address and port
KOVANICA_LISTEN_ADDR=0.0.0.0:8000

# RPC bind address and port
KOVANICA_RPC_ADDR=127.0.0.1
KOVANICA_RPC_PORT=8545

# Maximum connected P2P peers
KOVANICA_MAX_PEERS=50

# Initial P2P bootstrap nodes (comma-separated host:port or multiaddrs)
KOVANICA_BOOTNODES=testnet.kovanica.online:8000

# Mining & Block production (Chain 2 Hybrid PoW)
KOVANICA_RUN_VALIDATOR=true
KOVANICA_MINING_ENABLED=true
KOVANICA_MINING_THREADS=1
KOVANICA_MINING_AUTHOR=0

# Observability & Logging
RUST_LOG=info
