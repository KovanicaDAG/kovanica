{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "linear": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mseep/linear-mcp"
        ],
        "environment": {
          "LINEAR_API_KEY": "{env:LINEAR_API_KEY}"
        }
      },
      "notion": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@notionhq/notion-mcp-server"
        ],
        "environment": {
          "NOTION_TOKEN": "{env:NOTION_TOKEN}"
        }
      }
    }
  }
}
