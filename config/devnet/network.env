# Kovanica Devnet Configuration
# Network ID: kovanica-devnet
# Consensus: PoA-only (RFC-POA-Migration ratified 2026-09-25)
# Status: Local development network
#
# Ports: P2P 9002, Explorer 8082, Metrics 9092

KOVANICA_NETWORK=devnet
KOVANICA_NETWORK_ID=kovanica-devnet
KOVANICA_LISTEN=0.0.0.0:9002
KOVANICA_PEERS=

# Consensus: PoA-only
KOVANICA_POW=0
KOVANICA_CONSENSUS=poa
KOVANICA_POA_NOMINAL_WORK=1

# Slot duration (PoA fixed slot)
KOVANICA_SLOT_DURATION_MS=3000

# Node operation
KOVANICA_OPERATOR=1
KOVANICA_MINE=1
KOVANICA_MINE_SECS=10
KOVANICA_FAUCET=1
KOVANICA_ALLOW_RESET=1
KOVANICA_DATA=/opt/kovanica/devnet/data
KOVANICA_EXPLORER_PORT=8082
KOVANICA_METRICS_PORT=9092

# Consensus parameters (RFC-006)
KOVANICA_K=3
KOVANICA_FINALITY_DEPTH=100
KOVANICA_PRUNING_DEPTH=200
KOVANICA_MAX_SUPPLY=9020000000000000
KOVANICA_COINBASE_MATURITY=100
KOVANICA_SUBSIDY=1000000000
KOVANICA_FOUNDER_AMOUNT=20000000000000
KOVANICA_FOUNDER_SEED=1
KOVANICA_MIN_FEE=2000
KOVANICA_ATOM=100000000
