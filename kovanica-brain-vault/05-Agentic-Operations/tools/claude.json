      "file": "agents/subagents/vault-sync.md"
    },
    "protocol-dev": {
      "file": "agents/subagents/protocol-dev.md"
    },
    "doc-writer": {
      "file": "agents/subagents/doc-writer.md"
    },
    "code-reviewer": {
      "file": "agents/subagents/code-reviewer.md"
    },
    "test-engineer": {
      "file": "agents/subagents/test-engineer.md"
    },
    "release-engineer": {
      "file": "agents/subagents/release-engineer.md"
    },
    "performance-engineer": {
      "file": "agents/subagents/performance-engineer.md"
    },
    "security-auditor": {
      "file": "agents/subagents/security-auditor.md"
    },
    "devops-engineer": {
      "file": "agents/subagents/devops-engineer.md"
    },
    "api-designer": {
      "file": "agents/subagents/api-designer.md"
    },
    "migration-engineer": {
      "file": "agents/subagents/migration-engineer.md"
